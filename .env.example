BOT_TOKEN=replace-with-your-botfather-token
ADMIN_IDS=123456789
DATABASE_URL=sqlite:///bot.db
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT=120
MAX_CONCURRENT_DOWNLOADS=3
MAX_BATCH_SIZE=5
MAX_MEDIA_PER_POST=10
ENGINE_ATTEMPTS=2
RETRY_BASE_DELAY=2
RATE_LIMIT_SECONDS=10
MAX_REQUESTS_PER_MINUTE=6
COOLDOWN_SECONDS=3
TEMP_RETENTION_MINUTES=60
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ar
AUTO_DELETE=true
DROP_PENDING_UPDATES=false
PORT=0
# Optional: base64-encoded Netscape cookies.txt for Instagram Stories/login-gated public media.
INSTAGRAM_COOKIES_BASE64=
